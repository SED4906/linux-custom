/dts-v1/;
#include "mt8127.dtsi"

/ {
	model = "MediaTek MT8127 Amazon Fire 7 (ford, 2015)";
	compatible = "mediatek,mt8127";

	chosen {
		stdout-path = &mtk_fb;
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		mtk_fb: framebuffer@b7a00000 {
			compatible = "simple-framebuffer";
			width = <1024>;
			height = <600>;
			reg = <0 0xb7a00000 0 (1024 * 600 * 2)>;
			stride = <(1024 * 2)>;
			format = "r5g6b5";
		};
	};

	memory {
		device_type = "memory";
		reg = <0 0x80000000 0 0x37900000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		mtk_ram_console@83f00000 {
			reg = <0 0x83F00000 0 0x100000>;
		};
	};
};
