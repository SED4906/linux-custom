/dts-v1/;
#include "mt8127.dtsi"

/ {
	model = "MediaTek MT8127 Amazon Fire 7 (ford, 2015)";
	compatible = "mediatek,mt8127";

	memory {
		device_type = "memory";
		reg = <0 0x80000000 0 0x37900000>;
	};

	reserved-memory {
		mtk-ram-console {
			reg = <0 0x83F00000 0 0x100000>;
		};
	};
};

&uart0 {
	status = "okay";
};
